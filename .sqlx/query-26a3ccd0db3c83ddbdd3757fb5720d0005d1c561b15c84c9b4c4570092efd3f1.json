{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.kind, c.title, c.description, c.avatar_url, c.created_at,\n               cm.last_read_message_id\n        FROM chats c\n        JOIN chat_members cm ON cm.chat_id = c.id AND cm.user_id = $2\n        WHERE c.id = $1\n        ",
