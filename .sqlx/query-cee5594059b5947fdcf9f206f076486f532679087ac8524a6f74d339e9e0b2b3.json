{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.chat_id, m.sender_id, m.deleted_at, c.kind,\n               cm.role AS \"role!\"\n        FROM messages m\n        JOIN chats c ON c.id = m.chat_id\n        JOIN chat_members cm ON cm.chat_id = m.chat_id AND cm.user_id = $2\n        WHERE m.id = $1\n        ",
