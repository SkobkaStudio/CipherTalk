{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.display_name, u.avatar_url, u.last_seen_at,\n               cm.role, cm.joined_at, cm.last_read_message_id\n        FROM chat_members cm\n        JOIN users u ON u.id = cm.user_id\n        WHERE cm.chat_id = $1\n        ORDER BY cm.joined_at, u.id\n        ",
