  "query": "\n        UPDATE users\n        SET display_name = COALESCE($2, display_name),\n            bio = COALESCE($3, bio),\n            avatar_url = CASE WHEN $4 THEN $5 ELSE avatar_url END\n        WHERE id = $1\n        RETURNING id, username, email, display_name, bio, avatar_url, created_at, last_seen_at\n        ",
