  "query": "\n        SELECT id, username, display_name, bio, avatar_url, last_seen_at\n        FROM users\n        WHERE lower(username) LIKE $2 ESCAPE '\\'\n          AND id <> $1\n        ORDER BY username\n        LIMIT 20\n        ",
