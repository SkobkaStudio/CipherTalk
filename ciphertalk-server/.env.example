# Порт HTTP/WebSocket сервера
PORT=3000

# Путь к файлу базы данных (относительно ciphertalk-server/)
DB_FILE=./ciphertalk-db.json

# Шифровать SQLite-базу at-rest через SQLCipher. По умолчанию включено.
# Ключ лежит в файле <DB_FILE>.dbkey (создаётся автоматически, права 600).
# ВАЖНО: резервная копия БД бессмысленна без .dbkey — храните их вместе.
DB_ENCRYPTION=true
DB_KEY_FILE=./ciphertalk-db.json.dbkey

# Каталог для загруженных файлов
UPLOADS_DIR=./uploads

# Ограничение размера вложения в байтах (не более 20971520)
MAX_FILE_SIZE=20971520

# Разрешённые Origin для CORS через запятую.
# Пусто = cross-origin запрещён (same-origin, безопасный режим по умолчанию).
CORS_ORIGIN=

# Ключ шифрования данных на диске (AES-256-GCM).
# Если не задан, будет создан файл <DB_FILE>.key с правами 600.
# Для продакшена задайте длинную случайную строку.
ENCRYPTION_KEY=

# Секрет HMAC-SHA256 для подписи JWT-сессий.
# Если не задан, будет создан файл <DB_FILE>.jwt-secret с правами 600.
JWT_SECRET=

# SMS-провайдер для кодов подтверждения.
#   console — вывод кода в лог сервера (только для разработки!)
#   http    — generic HTTP API: POST {phone, code, text} на SMS_API_URL
#   twilio  — Twilio Messages API (TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM)
# В production код НЕ печатается в лог: если провайдер не настроен, отправка вернёт 503.
SMS_PROVIDER=console
# Разрешить вывод кода в консоль в production (только для тестов!)
SMS_CONSOLE_ALLOW=false
# Для провайдера http:
SMS_API_URL=
SMS_API_TOKEN=
# Шаблон текста SMS, {code} — код подтверждения
SMS_TEXT_TEMPLATE=CipherTalk: ваш код {code}
SMS_TIMEOUT_MS=10000
# Для провайдера twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ICE-серверы для WebRTC.
# STUN по умолчанию — публичные Google. Свой список: STUN_URLS=a,b
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN (нужен, если оба участника за symmetric NAT).
# Рекомендуемый вариант — coturn со static-auth-secret:
#   TURN_URL=turn:turn.example.com:3478?transport=udp
#   TURN_SECRET=<static-auth-secret из coturn>
# Сервер выдаёт клиенту одноразовые учётные данные (имя = <срок>: <случайное>,
# пароль = base64(HMAC-SHA1(secret, имя))).
TURN_URL=
TURN_SECRET=
# Альтернатива: статические учётные данные (менее безопасно)
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=3600

# Интервалы и сроки (мс/минуты)
SAVE_INTERVAL=10000
ONLINE_PING_INTERVAL=30000
HEARTBEAT_INTERVAL=30000
CODE_EXPIRY_MINUTES=5

# Минимальная длина логина и пароля
USERNAME_MIN_LENGTH=3
PASSWORD_MIN_LENGTH=6

# Аккаунт создателя CipherTalk (золотая галочка владельца).
OWNER_PHONE=+79000000000
