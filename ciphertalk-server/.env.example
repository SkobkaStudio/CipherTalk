# Порт HTTP/WebSocket сервера
PORT=3000

# Путь к файлу базы данных (относительно ciphertalk-server/)
DB_FILE=./ciphertalk-db.json

# Каталог для загруженных файлов
UPLOADS_DIR=./uploads

# Ограничение размера вложения в байтах (не более 20971520)
MAX_FILE_SIZE=20971520

# Разрешённые Origin для CORS через запятую (пусто = разрешить все)
CORS_ORIGIN=

# Ключ шифрования данных на диске (AES-256-GCM).
# Если не задан, будет создан файл <DB_FILE>.key с правами 600.
# Для продакшена задайте длинную случайную строку.
ENCRYPTION_KEY=

# Интервалы и сроки (мс/минуты)
SAVE_INTERVAL=10000
ONLINE_PING_INTERVAL=30000
HEARTBEAT_INTERVAL=30000
CODE_EXPIRY_MINUTES=5

# Минимальная длина логина и пароля
USERNAME_MIN_LENGTH=3
PASSWORD_MIN_LENGTH=6
