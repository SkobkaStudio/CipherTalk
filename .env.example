# Copy to .env and adjust values. Never commit the real .env.

# --- PostgreSQL -----------------------------------------------------------
DATABASE_URL=postgres://ciphertalk:ciphertalk@localhost:5432/ciphertalk
# Max connections in the SQLx pool.
DATABASE_MAX_CONNECTIONS=10
# Set to true to apply ./migrations automatically on startup.
RUN_MIGRATIONS=true

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- JWT / sessions -------------------------------------------------------
# Generate with: openssl rand -base64 48
# The placeholder below is rejected at startup on purpose.
JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_ISSUER=ciphertalk
# 15 minutes
ACCESS_TOKEN_TTL_SECS=900
# 30 days
REFRESH_TOKEN_TTL_SECS=2592000
# Refresh cookie is HttpOnly + SameSite=Lax and scoped to /api/auth.
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Media requests use a separate HttpOnly cookie scoped to /api/attachments.
MEDIA_TOKEN_TTL_SECS=86400

# --- HTTP server ----------------------------------------------------------
HOST=0.0.0.0
PORT=8080
STATIC_DIR=web
# Comma-separated list of allowed browser origins (empty = same-origin only).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Set to true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# --- Media -----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
MAX_AVATAR_MB=8

# --- Web Push (background notifications) -----------------------------------
# Generate once: see docs/DEPLOY_ARMBIAN.md. Leave empty to disable Web Push;
# in-page notifications still work. Stickers require ffmpeg/ffprobe on PATH.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Limits ---------------------------------------------------------------
MAX_MESSAGE_LEN=4096
MAX_GROUP_MEMBERS=500
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=600

# --- Logging --------------------------------------------------------------
RUST_LOG=ciphertalk=debug,tower_http=info,sqlx=warn
