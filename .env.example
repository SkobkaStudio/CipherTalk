# Порт HTTP/WebSocket сервера
PORT=3000

# Путь к файлу базы данных SQLite
DB_FILE=./ciphertalk-db.sqlite

# Шифрование SQLite at-rest (SQLCipher). true = включено.
DB_ENCRYPTION=true
DB_KEY_FILE=./ciphertalk-db.sqlite.dbkey

# Каталог для загруженных файлов (шифротекст)
UPLOADS_DIR=./uploads

# Лимит вложения в байтах (по умолчанию 20 МБ)
MAX_FILE_SIZE=20971520

# Разрешённые Origin для CORS (через запятую). Пусто = same-origin.
CORS_ORIGIN=

# Ключ шифрования данных на диске AES-256-GCM.
# Если пуст — создастся файл <DB_FILE>.key (права 600).
ENCRYPTION_KEY=

# Секрет HMAC-SHA256 для подписи JWT-сессий.
# Если пуст — создастся файл <DB_FILE>.jwt-secret (права 600).
JWT_SECRET=

# SMS-провайдер: console | http | twilio
SMS_PROVIDER=console
# Разрешить вывод кода в консоль в production
SMS_CONSOLE_ALLOW=false
SMS_API_URL=
SMS_API_TOKEN=
SMS_TEXT_TEMPLATE=CipherTalk: ваш код {code}
SMS_TIMEOUT_MS=10000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ICE-серверы для WebRTC (STUN + опциональный TURN)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=3600

# Интервалы и сроки
SAVE_INTERVAL=10000
ONLINE_PING_INTERVAL=30000
HEARTBEAT_INTERVAL=30000
CODE_EXPIRY_MINUTES=5
SESSION_TTL_DAYS=30

# Минимальная длина логина и пароля
USERNAME_MIN_LENGTH=3
PASSWORD_MIN_LENGTH=6

# Аккаунт создателя (золотая корона)
OWNER_PHONE=+79000000000
